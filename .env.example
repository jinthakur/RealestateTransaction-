# Copy to .env and fill in. NEVER commit .env.
# The mnemonic of your TESTNET wallet. Index 0 is the address you funded;
# the other demo roles (agent, inspector, check service, subcontractor) are derived from it.
MNEMONIC="word1 word2 ... word12"

# XRPL EVM Testnet
RPC_URL=https://rpc.testnet.xrplevm.org
CHAIN_ID=1449000
EXPLORER=https://explorer.testnet.xrplevm.org

# Demo amounts in XRP
PHASE_AMOUNT=0.5
AGENT_BUDGET=0.1
AGENT_MAX_PER_CALL=0.02
CHECK_PRICE=0.01
GAS_TOPUP=0.05

# Check service
SERVICE_URL=http://localhost:4020
SCENARIO=pass   # set to "fail" to see the agent decline

# Agent: "rules" (no AWS needed) or "bedrock"
AGENT_MODE=rules
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- AP4M (Mastercard) payment rail: set PAYMENTS=ap4m to pay checks in RLUSD via Channels ---
# Onboard wallets on https://hackathon.ap4m.build/participant first (My setup tab).
PAYMENTS=xrp
AP4M_API_URL=https://hackathon.ap4m.build
AP4M_TEAM_NAME=your-team-name
# Agent wallet onboarded on My setup (testnet only; never commit). Blank = demo agent wallet.
AGENT_PRIVATE_KEY=
# Wallet that sends merchant redemptions (needs XRP gas). Blank = demo checkService wallet.
MERCHANT_SUBMITTER_KEY=
MERCHANT_ID=
MERCHANT_PAYOUT=
# Optional: reuse an open Channel; otherwise one is opened with this RLUSD cap
AP4M_CHANNEL_ID=
AP4M_CHANNEL_CAP=0.2
CHECK_PRICE_RLUSD=0.01
