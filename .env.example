# RealestateTransaction: copy to .env and fill in. NEVER commit .env.

# --- Wallets (TESTNET ONLY) ---
# Roles are derived from this mnemonic, path m/44'/60'/0'/0/i:
#   0 buyer (funded; deploys the escrow, deposits 10%; also the AP4M agent wallet)
#   1 inspector (the AI agent's on-chain identity)   2 attorney   3 checkService   4 seller
MNEMONIC="word1 word2 ... word12"

# --- XRPL EVM Testnet ---
RPC_URL=https://rpc.testnet.xrplevm.org
CHAIN_ID=1449000
EXPLORER=https://explorer.testnet.xrplevm.org

# --- Deal (amounts in XRP) ---
PRICE=5                                   # home price; 10% goes into the attorney escrow
PROPERTY="24 Linden Ave, Brooklyn NY (demo listing)"
AGENT_BUDGET=0.1
AGENT_MAX_PER_CALL=0.02
CHECK_PRICE=0.01
GAS_TOPUP=0.05

# --- Portal / dashboard ---
PORTAL_PORT=3100
PORTAL_URL=http://localhost:3100

# --- Deal agent ---
# "rules" = deterministic, no AWS needed (reliable fallback); "bedrock" = Amazon Bedrock Converse tool use
AGENT_MODE=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# PowerShell-style file with temporary AWS credentials, lines like:  $Env:AWS_ACCESS_KEY_ID = "..."
# (also AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN). Keep it OUTSIDE the repo; never commit it.
AWS_CREDENTIALS_FILE=C:\Users\you\awscredential.txt
ORCH_TIMEOUT_MIN=30

# --- Email notifications (nodemailer, SMTP over TLS) ---
# Every event sends a "From -> To" email. All emails go to ONE mailbox (NOTIFY_TO);
# the subject says who it is for, e.g. "Seller to Attorney message".
# Leave SMTP_USER/SMTP_PASS blank to skip email. Certificate checking is disabled for the hackathon mail host.
SMTP_HOST=mail.askyourquestions.info
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=                                # defaults to SMTP_USER when blank

# --- Payments for the 4 inspection checks ---
# ap4m = RLUSD Channel vouchers via Mastercard AP4M (x402). xrp = native XRP x402-style (run `npm run service`).
PAYMENTS=ap4m
SCENARIO=pass                             # "fail" makes a check fail (failure demo)
SERVICE_URL=http://localhost:4020         # PAYMENTS=xrp only

# --- Mastercard AP4M ---
# Onboard wallets at https://hackathon.ap4m.build/participant (My setup tab) first.
AP4M_API_URL=https://hackathon.ap4m.build
AP4M_TEAM_NAME=your-team-name
AP4M_AGENT_ROLE=buyer                     # which derived wallet is the onboarded AP4M agent
# Optional overrides (testnet only; never commit). Blank = use the derived wallets.
AGENT_PRIVATE_KEY=
MERCHANT_SUBMITTER_KEY=                   # sends merchant voucher redemptions (needs XRP for gas)
MERCHANT_ID=
MERCHANT_PAYOUT=
# Reuse an open Channel, otherwise one is opened with this RLUSD cap
AP4M_CHANNEL_ID=
AP4M_CHANNEL_CAP=0.2
CHECK_PRICE_RLUSD=0.01
